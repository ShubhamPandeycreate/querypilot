# Copy this file to .env and fill in your keys. All three have free tiers:
#   Gemini:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/settings/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides (defaults shown). Model names rotate — if a provider 404s,
# list what your key can reach (Gemini: /models endpoint; OpenRouter: /api/v1/models,
# filter ":free" suffix) and update here. Pin exact Gemini versions for eval runs.
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openai/gpt-oss-20b:free   # alt: nvidia/nemotron-3-super-120b-a12b:free
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1
