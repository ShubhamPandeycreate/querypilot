# Optional. Copy to .streamlit/secrets.toml (git-ignored) for a local run, or
# paste the contents into the deployment's secrets box:
#   Streamlit Community Cloud -> app -> Settings -> Secrets
#   Hugging Face Spaces       -> Settings -> Variables and secrets
#
# Every key here is the OPERATOR's key: visitors who paste their own key in the
# sidebar bypass it entirely. Sessions that fall back to it are capped by
# dbagent.budget.DEMO_BUDGET, and all sessions together share the hourly window
# in SHARED_KEY_CALLS_PER_HOUR.
#
# Leave this file out and the app still works — it just asks each visitor for
# their own free key. That is the safe default for a public deployment.

# gemini_api_key = "..."
# groq_api_key = "..."
# openrouter_api_key = "..."
